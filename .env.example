# Copy to .env; launch.sh loads this file. Never commit real credentials.
APP_URL=http://localhost:8787
DATABASE_URL=
OPENAI_API_KEY=
# Choose a Responses API model available to your account. No default is assumed.
OPENAI_MODEL=
WHISPER_MODEL=base
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Generate once with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
MAX_UPLOAD_BYTES=21474836480

# Optional sampled music recognition (paid third-party API; opt-in per job)
AUDD_API_TOKEN=

# Enable Direct Post only for a developer application whose approved use permits it.
# This local private utility defaults to the official manual TikTok uploader.
TIKTOK_DIRECT_POST_ENABLED=false
TIKTOK_APP_AUDITED=false
# Only enable delayed TikTok sends if explicitly permitted for your approved app/use.
TIKTOK_SCHEDULING_APPROVED=false
CREATOR_SCHEDULER_ENABLED=true
# TOKEN_ENCRYPTION_KEY is now optional: a 0600 local key is generated in data/oauth.key.
